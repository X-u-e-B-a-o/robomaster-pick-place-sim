<?xml version="1.0"?>
<robot name="robomaster_ep_core">
  <link name="world"/>

  <link name="base_link">
    <inertial><mass value="6.0"/><origin xyz="0 0 0"/><inertia ixx="0.12" ixy="0" ixz="0" iyy="0.18" iyz="0" izz="0.22"/></inertial>
    <visual><origin xyz="0 0 0.08"/><geometry><box size="0.42 0.32 0.12"/></geometry><material name="black"><color rgba="0.02 0.02 0.02 1"/></material></visual>
    <collision><origin xyz="0 0 0.08"/><geometry><box size="0.42 0.32 0.12"/></geometry></collision>
  </link>

  <joint name="world_to_base" type="fixed">
    <parent link="world"/><child link="base_link"/><origin xyz="0 0 0.01"/>
  </joint>

  <link name="upper_arm_link">
    <inertial><mass value="0.45"/><origin xyz="0.14 0 0"/><inertia ixx="0.003" ixy="0" ixz="0" iyy="0.006" iyz="0" izz="0.006"/></inertial>
    <visual><origin xyz="0.14 0 0"/><geometry><box size="0.28 0.035 0.06"/></geometry><material name="arm_black"><color rgba="0.01 0.01 0.01 1"/></material></visual>
    <collision><origin xyz="0.14 0 0"/><geometry><box size="0.28 0.035 0.06"/></geometry></collision>
  </link>

  <joint name="arm_lift_joint" type="revolute">
    <parent link="base_link"/><child link="upper_arm_link"/>
    <origin xyz="0.18 0 0.16" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-0.8" upper="1.0" effort="20" velocity="1.0"/>
    <dynamics damping="0.8" friction="0.1"/>
  </joint>

  <link name="wrist_link">
    <inertial><mass value="0.25"/><origin xyz="0.10 0 0"/><inertia ixx="0.001" ixy="0" ixz="0" iyy="0.003" iyz="0" izz="0.003"/></inertial>
    <visual><origin xyz="0.10 0 0"/><geometry><box size="0.20 0.035 0.045"/></geometry><material name="wrist_black"><color rgba="0.02 0.02 0.02 1"/></material></visual>
    <collision><origin xyz="0.10 0 0"/><geometry><box size="0.20 0.035 0.045"/></geometry></collision>
  </link>

  <joint name="wrist_pitch_joint" type="revolute">
    <parent link="upper_arm_link"/><child link="wrist_link"/>
    <origin xyz="0.28 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.2" upper="1.2" effort="10" velocity="1.0"/>
    <dynamics damping="0.6" friction="0.1"/>
  </joint>

  <link name="gripper_base_link">
    <inertial><mass value="0.15"/><origin xyz="0 0 0"/><inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/></inertial>
    <visual><geometry><box size="0.06 0.13 0.04"/></geometry><material name="gray"><color rgba="0.12 0.12 0.12 1"/></material></visual>
    <collision><geometry><box size="0.06 0.13 0.04"/></geometry></collision>
  </link>

  <joint name="wrist_to_gripper" type="fixed">
    <parent link="wrist_link"/><child link="gripper_base_link"/>
    <origin xyz="0.22 0 0"/>
  </joint>

  <link name="left_finger_link">
    <inertial><mass value="0.05"/><origin xyz="0.06 0 0"/><inertia ixx="0.0002" ixy="0" ixz="0" iyy="0.0004" iyz="0" izz="0.0004"/></inertial>
    <visual><origin xyz="0.06 0 0"/><geometry><box size="0.12 0.018 0.035"/></geometry><material name="finger"><color rgba="0.01 0.01 0.01 1"/></material></visual>
    <collision><origin xyz="0.06 0 0"/><geometry><box size="0.12 0.018 0.035"/></geometry></collision>
  </link>

  <link name="right_finger_link">
    <inertial><mass value="0.05"/><origin xyz="0.06 0 0"/><inertia ixx="0.0002" ixy="0" ixz="0" iyy="0.0004" iyz="0" izz="0.0004"/></inertial>
    <visual><origin xyz="0.06 0 0"/><geometry><box size="0.12 0.018 0.035"/></geometry><material name="finger2"><color rgba="0.01 0.01 0.01 1"/></material></visual>
    <collision><origin xyz="0.06 0 0"/><geometry><box size="0.12 0.018 0.035"/></geometry></collision>
  </link>

  <joint name="left_finger_joint" type="prismatic">
    <parent link="gripper_base_link"/><child link="left_finger_link"/>
    <origin xyz="0.03 0.035 0"/><axis xyz="0 1 0"/>
    <limit lower="0.0" upper="0.045" effort="20" velocity="0.2"/>
    <dynamics damping="2.0" friction="0.2"/>
  </joint>

  <joint name="right_finger_joint" type="prismatic">
    <parent link="gripper_base_link"/><child link="right_finger_link"/>
    <origin xyz="0.03 -0.035 0"/><axis xyz="0 -1 0"/>
    <limit lower="0.0" upper="0.045" effort="20" velocity="0.2"/>
    <dynamics damping="2.0" friction="0.2"/>
  </joint>

  <ros2_control name="GazeboSystem" type="system">
    <hardware><plugin>gz_ros2_control/GazeboSimSystem</plugin></hardware>
    <joint name="arm_lift_joint"><command_interface name="position"/><state_interface name="position"/><state_interface name="velocity"/></joint>
    <joint name="wrist_pitch_joint"><command_interface name="position"/><state_interface name="position"/><state_interface name="velocity"/></joint>
    <joint name="left_finger_joint"><command_interface name="position"/><state_interface name="position"/><state_interface name="velocity"/></joint>
    <joint name="right_finger_joint"><command_interface name="position"/><state_interface name="position"/><state_interface name="velocity"/></joint>
  </ros2_control>

  <gazebo>
    <plugin filename="libgz_ros2_control-system.so" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
      <parameters>/home/nvidia/colcon_ws/src/robomaster_pick_place_sim/config/controllers.yaml</parameters>
    </plugin>
  </gazebo>
</robot>
