<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>robomaster_ep_driver</name>
  <version>0.1.0</version>
  <description>RoboMaster EP 真机驱动: 用官方 Python SDK 控制机械臂/夹爪, 对外提供与仿真阶段相同的 ros2_control 兼容接口 (joint_states + FollowJointTrajectory + gripper commands + list_controllers)</description>
  <maintainer email="you@example.com">davidliu</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>control_msgs</exec_depend>
  <exec_depend>controller_manager_msgs</exec_depend>
  <exec_depend>robomaster_pick_place_sim</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
